{
  "name": "siparas-monorepo",
  "version": "1.0.0",
  "description": "SIPARAS - Sistem Informasi Prasarana & Sarana YGPKB (Monorepo)",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names \"FRONTEND,BACKEND\" --prefix-colors \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && php artisan serve --port=8000",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm install && cd frontend && npm install",
    "build:frontend": "cd frontend && npm run build",
    "migrate": "cd backend && php artisan migrate",
    "seed": "cd backend && php artisan db:seed",
    "migrate:fresh": "cd backend && php artisan migrate:fresh --seed",
    "test:backend": "cd backend && php artisan test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}

